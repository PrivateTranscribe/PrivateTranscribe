{
  "appId": "com.privatetranscribe.app",
  "productName": "PrivateTranscribe",
  "directories": {
    "output": "dist"
  },
  "afterPack": "scripts/after-pack-win.js",
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "node_modules/**/*",
    "src/dist/**/*",
    "src/helpers/**/*",
    "src/config/**/*",
    "src/hooks/**/*",
    "src/models/**/*",
    "src/services/localReasoningBridge.js",
    "src/types/**/*",
    "src/utils.js",
    "src/utils/**/*",
    "src/updater.js",
    "src/components.json",
    "!node_modules/.cache/**/*",
    "!src/node_modules/**/*",

    "!**/node_modules/electron/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/app-builder-bin/**",
    "!**/node_modules/app-builder-lib/**",
    "!**/node_modules/builder-util/**",
    "!**/node_modules/dmg-builder/**",
    "!**/node_modules/7zip-bin/**",

    "!**/node_modules/typescript/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/eslint/**",
    "!**/node_modules/eslint-*/**",
    "!**/node_modules/@eslint/**",
    "!**/node_modules/@typescript-eslint/**",
    "!**/node_modules/globals/**",

    "!**/node_modules/vite/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/@esbuild/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/@rollup/**",

    "!**/node_modules/tailwindcss/**",
    "!**/node_modules/@tailwindcss/**",
    "!**/node_modules/lightningcss*/**",

    "!**/node_modules/react/**",
    "!**/node_modules/react-dom/**",
    "!**/node_modules/lucide-react/**",
    "!**/node_modules/@radix-ui/**",
    "!**/node_modules/class-variance-authority/**",
    "!**/node_modules/clsx/**",
    "!**/node_modules/tailwind-merge/**",
    "!**/node_modules/react-markdown/**",

    "!**/node_modules/@types/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/cross-env/**",
    "!**/node_modules/@electron/notarize/**",

    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**",
    "!**/node_modules/**/*.ts",
    "!**/node_modules/**/*.map",
    "!**/node_modules/**/CHANGELOG*",
    "!**/node_modules/**/.github/**"
  ],
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**/*",
    "**/node_modules/better-sqlite3/**/*",
    "**/node_modules/sherpa-onnx-node/**/*",
    "**/node_modules/sherpa-onnx-*/*",
    "**/node_modules/onnxruntime-node/**"
  ],
  "extraResources": [
    "src/assets/**/*",
    {
      "from": "THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "resources/models/silero-vad.onnx",
      "to": "models/silero-vad.onnx"
    },
    {
      "from": "resources/readaloud-copy-worker.ps1",
      "to": "readaloud-copy-worker.ps1"
    },
    {
      "from": "resources/readaloud-highlight-worker.ps1",
      "to": "readaloud-highlight-worker.ps1"
    },
    {
      "from": "resources/bin/",
      "to": "bin/",
      "filter": [
        "whisper-cpp-*",
        "whisper-server-*",
        "llama-server-*",
        "sherpa-onnx-*",
        "windows-key-listener.exe"
      ]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "src/assets/icon.icns",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "entitlements": "resources/mac/entitlements.mac.plist",
    "entitlementsInherit": "resources/mac/entitlements.mac.plist",
    "identity": "HeroTools Inc. (9R85XFMH59)",
    "extraResources": [
      "resources/macos-globe-listener.swift",
      "resources/bin/macos-globe-listener",
      {
        "from": "resources/bin/",
        "to": "bin/",
        "filter": ["*.dylib"]
      }
    ],
    "extendInfo": {
      "LSUIElement": false,
      "NSMicrophoneUsageDescription": "PrivateTranscribe needs microphone access for speech-to-text transcription.",
      "NSAccessibilityUsageDescription": "PrivateTranscribe needs accessibility permissions to paste transcribed text into other applications."
    }
  },
  "win": {
    "target": ["nsis"],
    "signAndEditExecutable": false,
    "verifyUpdateCodeSignature": true,
    "azureSignOptions": {
      "endpoint": "https://neu.codesigning.azure.net/",
      "codeSigningAccountName": "PrivateTranscribe",
      "certificateProfileName": "PrivateTranscribe",
      "publisherName": "Julsgaard Products",
      "TimestampRfc3161": "http://timestamp.acs.microsoft.com",
      "TimestampDigest": "SHA256"
    },
    "icon": "src/assets/icon.ico",
    "executableName": "PrivateTranscribe",
    "extraResources": [
      {
        "from": "resources/bin/",
        "to": "bin/",
        "filter": [
          "*.dll",
          "!ggml-cuda.dll",
          "!ggml-vulkan.dll",
          "!cublas*.dll",
          "!cudart*.dll",
          "!libomp140.x86_64.dll",
          "windows-fast-paste.exe",
          "windows-mic-watch.exe",
          "windows-hold-key.exe"
        ]
      },
      {
        "from": "resources/bin/",
        "to": "app.asar.unpacked/node_modules/onnxruntime-node/bin/napi-v3/win32/x64/",
        "filter": ["msvcp140.dll", "msvcp140_1.dll", "vcruntime140.dll", "vcruntime140_1.dll"]
      }
    ]
  },
  "linux": {
    "target": ["AppImage", "deb", "tar.gz"],
    "icon": "src/assets/icon.png",
    "category": "Utility",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "flatpak": {
    "runtime": "org.freedesktop.Platform",
    "runtimeVersion": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "useWaylandFlags": true,
    "finishArgs": [
      "--socket=wayland",
      "--socket=fallback-x11",
      "--share=network",
      "--share=ipc",
      "--device=dri",
      "--socket=pulseaudio",
      "--filesystem=home",
      "--filesystem=xdg-documents",
      "--filesystem=xdg-download",
      "--talk-name=org.freedesktop.Notifications",
      "--talk-name=org.freedesktop.portal.Desktop"
    ]
  },
  "deb": {
    "afterRemove": "resources/linux/after-remove.sh",
    "fpm": ["--deb-recommends", "xdotool", "--deb-recommends", "wtype"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "selectPerMachineByDefault": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PrivateTranscribe",
    "uninstallDisplayName": "PrivateTranscribe",
    "include": "resources/nsis/cleanup-models.nsh"
  },
  "dmg": {
    "title": "PrivateTranscribe",
    "icon": "src/assets/icon.icns",
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "publish": {
    "provider": "generic",
    "url": "https://updates.privatetranscribe.com/win"
  }
}
