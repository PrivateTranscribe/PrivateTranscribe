{
  "name": "privatetranscribe",
  "version": "0.13.5",
  "description": "PrivateTranscribe",
  "main": "main.js",
  "private": true,
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:winkeys": "node scripts/build-windows-key-listener.js",
    "compile:native": "npm run compile:globe && npm run compile:winkeys",
    "prestart": "npm run compile:native",
    "start": "electron .",
    "predev": "npm run compile:native",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "predev:main": "npm run compile:native",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prepare:resources": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx",
    "prebuild": "npm run prepare:resources",
    "build": "cd src && vite build && cd .. && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "prebuild:mac": "npm run prepare:resources",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "prebuild:win": "npm run prepare:resources",
    "build:win": "npm run build:renderer && electron-builder --win",
    "prebuild:linux": "npm run prepare:resources",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "setup": "node setup.js",
    "prepack": "npm run prepare:resources",
    "pack": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "predist": "npm run prepare:resources",
    "dist": "npm run build:renderer && electron-builder",
    "download:whisper-cpp": "node scripts/download-whisper-cpp.js --current",
    "download:whisper-cpp:all": "node scripts/download-whisper-cpp.js --all",
    "download:llama-server": "node scripts/download-llama-server.js --current",
    "download:llama-server:all": "node scripts/download-llama-server.js --all",
    "download:sherpa-onnx": "node scripts/download-sherpa-onnx.js --current",
    "download:sherpa-onnx:all": "node scripts/download-sherpa-onnx.js --all",
    "download:benchmark-audio": "node scripts/download-benchmark-audio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node tests/setup-validation.test.js",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js",
    "uninstall:full:mac": "bash scripts/complete-uninstall.sh",
    "uninstall:full:linux": "bash scripts/complete-uninstall-linux.sh",
    "uninstall:full:windows": "scripts\\complete-uninstall-windows.bat",
    "audit:branding": "node scripts/audit-branding.js",
    "fixture:long-transcribe": "node scripts/create-long-transcribe-fixture.js",
    "smoke:diarization": "node scripts/diarization-smoke.js"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "PrivateTranscribe Team",
    "email": "support@privatetranscribe.com"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.4.0",
    "electron-winstaller": "5.4.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.10",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.2.0",
    "form-data": "^4.0.5",
    "lucide-react": "^0.518.0",
    "node-machine-id": "^1.1.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "sherpa-onnx-node": "^1.13.1",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.13",
    "unzipper": "^0.12.3",
    "ws": "^8.20.1"
  },
  "overrides": {
    "xml2js": "^0.6.2",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.3",
    "uuid": "^14.0.0"
  }
}
